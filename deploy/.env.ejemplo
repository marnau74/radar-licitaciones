# Copiar como .env junto a compose.yaml y rellenar. El .env no se sube nunca al repositorio.

# Versión de las imágenes publicadas (sin la «v»): https://github.com/marnau74/radar-licitaciones/releases
VERSION=0.1.0

# Dominio público (con su registro DNS apuntando al servidor).
RADAR_DOMINIO=radar.ejemplo.es

# Claves largas y aleatorias, por ejemplo: openssl rand -base64 32
POSTGRES_CLAVE=
KEYCLOAK_DB_CLAVE=

# Administrador de Keycloak (solo para la consola, por túnel SSH).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_CLAVE=

# Servidor de correo para los avisos (STARTTLS).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=avisos@radar.ejemplo.es
