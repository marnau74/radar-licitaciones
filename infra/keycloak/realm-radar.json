{
  "realm": "radar",
  "displayName": "Radar de licitaciones",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Lanza ingestas y consulta su estado" }
    ]
  },
  "clients": [
    {
      "clientId": "radar-web",
      "name": "Radar de licitaciones (web)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*", "http://localhost:8088/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8088/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia radar-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "radar-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles del realm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana@demo.example",
      "email": "ana@demo.example",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Demo",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "radar-demo-2026", "temporary": false }]
    },
    {
      "username": "admin@demo.example",
      "email": "admin@demo.example",
      "emailVerified": true,
      "firstName": "Administración",
      "lastName": "Demo",
      "enabled": true,
      "realmRoles": ["admin"],
      "credentials": [{ "type": "password", "value": "radar-demo-2026", "temporary": false }]
    }
  ]
}
