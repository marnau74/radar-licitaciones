# Plantilla de nginx: al arrancar el contenedor se sustituyen las variables ${RADAR_...}.
# La API y Keycloak van por el mismo dominio (los reparte Caddy), así que aquí solo se sirve la web.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Cabeceras de seguridad. Angular inyecta los estilos de los componentes en línea: style-src necesita
    # 'unsafe-inline'; los scripts, no.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /salud {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Configuración de la web en tiempo de ejecución.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 '{"api":"/api","oidc":{"emisor":"${RADAR_OIDC_EMISOR}","cliente":"${RADAR_OIDC_CLIENTE}"}}';
    }

    # Los ficheros con huella en el nombre no cambian nunca: caché de un año.
    location ~* \.(?:js|css|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Aplicación de una sola página: cualquier ruta desconocida es index.html, que nunca se guarda en caché.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri $uri/ /index.html;
    }
}
